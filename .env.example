# Copy to .env and fill in. .env is gitignored — never commit the real token.
# Local dev:  copy .env.example .env   (Windows: copy .env.example .env)
# On Render/Railway: set these as environment variables in the dashboard instead.
BOT_TOKEN=put-your-telegram-token-here
# Optional overrides:
# STATE_FILE=bot_state.json
# SCRAPE_INTERVAL=120
# PORT=10000
